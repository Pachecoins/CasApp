// TUKI — Prisma Schema
// Plataforma on-demand de servicios para el hogar (MVP: Jardinería + Piletas)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

// KYC verification lifecycle for worker identity + insurance documents
enum KycStatus {
  PENDING    // not yet submitted
  SUBMITTED  // docs uploaded, awaiting external review
  APPROVED   // external KYC provider (or admin) approved
  REJECTED   // rejected — worker must re-submit
}

enum Role {
  CLIENT
  WORKER
  ADMIN
}

// TUKI order state machine:
// searching → assigned → en_route → in_progress → finished_pending_approval
//          → completed  |  disputed
enum OrderStatus {
  SEARCHING                 // client submitted, broadcasting to nearby workers
  ASSIGNED                  // a worker accepted (atomic claim)
  EN_ROUTE                  // worker pressed "En camino"
  IN_PROGRESS               // worker pressed "Llegué al domicilio"
  FINISHED_PENDING_APPROVAL // worker uploaded completion photo, awaiting client approval
  COMPLETED                 // client pressed "Todo excelente / Liberar pago"
  DISPUTED                  // client opened a dispute; funds frozen pending moderator
  CANCELLED                 // cancelled before a worker was assigned
}

// Visual lot-size selector shown to the client during quoting
enum LotSize {
  SMALL   // "Chico"   — up to ~100 m²
  MEDIUM  // "Mediano" — 100–300 m²
  LARGE   // "Grande"  — 300 m²+
}

// Worker equipment tier; drives per-m² pricing
enum EquipmentTier {
  STANDARD // manual / basic tools — cheaper, slower
  PREMIUM  // tractors, robots, advanced machinery — faster, pricier
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PaymentStatus {
  PENDING
  CAPTURED  // funds captured in escrow
  RELEASED  // funds transferred to worker wallet
  REFUNDED  // funds returned to client
  FAILED
}

// Escrow lifecycle tracked per-transaction
enum EscrowStatus {
  HELD      // captured, held by TUKI
  RELEASED  // disbursed to worker (triggered by client approval)
  FROZEN    // dispute opened — no movement until moderator resolves
  REFUNDED  // returned to client
}

enum TransactionMethod {
  MERCADOPAGO
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum ProductOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum EquipmentRentalStatus {
  PENDING   // requested by client, awaiting owner confirmation
  CONFIRMED // owner confirmed, awaiting start date
  ACTIVE    // currently rented out
  COMPLETED
  CANCELLED
}

enum CourseEnrollmentStatus {
  PENDING    // enrolled, payment (if any) not yet confirmed
  ACTIVE     // payment confirmed (or free) — worker has access
  COMPLETED
  CANCELLED
}

// Qualitative review tags ("Puntual", "Honesto", "Prolijo", ...)
enum ReviewTag {
  PUNCTUAL     // Puntual
  HONEST       // Honesto
  TIDY         // Prolijo
  PROFESSIONAL // Profesional
  CAREFUL      // Cuidadoso
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  phone        String?
  firstName    String
  lastName     String
  avatarUrl    String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfile     ClientProfile?
  workerProfile     WorkerProfile?
  notifications     Notification[]
  reviewsGiven      Review[]           @relation("ReviewerRelation")
  reviewsReceived   Review[]           @relation("RevieweeRelation")
  chatMessages      ChatMessage[]
  pushSubscriptions PushSubscription[]
  equipmentRentals  EquipmentRental[]
  productOrders     ProductOrder[]

  @@index([email])
  @@map("users")
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────

model ClientProfile {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  preferredPaymentMethod String?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses       ClientAddress[]
  serviceRequests ServiceRequest[]
  subscriptions   Subscription[]

  @@map("client_profiles")
}

// Clients can have multiple saved addresses (home, country, office, …)
model ClientAddress {
  id               String  @id @default(cuid())
  clientId         String
  label            String  @default("Casa") // "Casa", "Trabajo", "Country", etc.
  address          String
  latitude         Float
  longitude        Float
  // Gated-community flag: only workers with validated ART/insurance are shown
  isGatedCommunity Boolean @default(false)
  isDefault        Boolean @default(false)

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_addresses")
}

// ─── WORKER ──────────────────────────────────────────────────────────────────

model WorkerProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  bio              String?
  rating           Float         @default(0)
  totalReviews     Int           @default(0)
  isAvailable      Boolean       @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  radiusKm         Float         @default(10)

  // Onboarding / integrity filter
  isVerified         Boolean   @default(false)
  identityVerified   Boolean   @default(false)
  dniFrontUrl        String?   // photo of DNI front
  dniBackUrl         String?   // photo of DNI back
  selfieBiometricUrl String?   // selfie for biometric check
  kycStatus          KycStatus @default(PENDING)
  kycProviderRef     String?   // external KYC provider reference ID

  // ART / personal-accident insurance — required for gated-community jobs
  insurancePolicyUrl  String?
  insuranceVerified   Boolean   @default(false)
  insuranceExpiresAt  DateTime?

  // Bank account: must match DNI (validated before first payout)
  bankCvu             String?  // CBU/CVU (stored encrypted in production)
  bankAccountVerified Boolean  @default(false)

  // MercadoPago Marketplace — worker's linked MP account for automatic splits
  mpUserId       String? // worker's MP user ID (from OAuth)
  mpAccessToken  String? // worker's MP access token (encrypted in production)
  mpRefreshToken String?
  mpTokenExpiresAt DateTime?

  // Wallet balance (in ARS cents to avoid float rounding)
  walletBalanceCents Int @default(0)

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerServices WorkerService[]
  equipment      WorkerEquipment[]
  products       WorkerProduct[]
  serviceRequests ServiceRequest[]
  subscriptions  Subscription[]
  courseEnrollments CourseEnrollment[]

  @@index([isAvailable, currentLatitude, currentLongitude])
  @@map("worker_profiles")
}

// Equipment items uploaded by the worker to justify their tier / pricing
model WorkerEquipment {
  id          String    @id @default(cuid())
  workerId    String
  name        String    // "Cortadora de pasto Husqvarna", "Robot cortacésped", etc.
  description String?
  photoUrl    String
  // Admin verifies equipment matches claimed tier
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  // Equipment rental marketplace — worker offers their own machine for rent
  isForRent        Boolean @default(false)
  pricePerDayCents  Int?

  worker  WorkerProfile     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  rentals EquipmentRental[]

  @@index([workerId])
  @@index([isForRent])
  @@map("worker_equipment")
}

// A client booking a worker's machine for a date range
model EquipmentRental {
  id              String                @id @default(cuid())
  equipmentId     String
  renterId        String
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  totalPriceCents Int
  status          EquipmentRentalStatus @default(PENDING)
  paymentStatus   PaymentStatus         @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  equipment WorkerEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  renter    User            @relation(fields: [renterId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([renterId])
  @@map("equipment_rentals")
}

// ─── PRODUCTS MARKETPLACE ──────────────────────────────────────────────────────
// Workers sell self-made / recycled products (e.g. firewood briquettes made
// from leaves collected on gardening jobs) alongside their regular services.

model WorkerProduct {
  id          String   @id @default(cuid())
  workerId    String
  name        String   // "Briquetas de carbón ecológico (hojas recicladas)"
  description String?
  photoUrl    String
  priceCents  Int
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  worker WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  orders ProductOrder[]

  @@index([workerId])
  @@index([isActive])
  @@map("worker_products")
}

model ProductOrder {
  id              String             @id @default(cuid())
  productId       String
  buyerId         String
  quantity        Int
  totalPriceCents Int
  status          ProductOrderStatus @default(PENDING)
  paymentStatus   PaymentStatus      @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  product WorkerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([buyerId])
  @@map("product_orders")
}

// ─── COURSES (admin-managed catalog, "para trabajadores") ──────────────────────
// Workers browse a platform catalog of courses. Highly-rated workers
// (rating >= freeAboveRating) get free access; everyone else pays.

model Course {
  id              String   @id @default(cuid())
  title           String
  description     String?
  thumbnailUrl    String?
  contentUrl      String?  // video/lesson content link
  priceCents      Int      @default(0)
  // Workers with rating >= this threshold enroll for free. Null = never free.
  freeAboveRating Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  enrollments CourseEnrollment[]

  @@index([isActive])
  @@map("courses")
}

model CourseEnrollment {
  id            String                 @id @default(cuid())
  courseId      String
  workerId      String
  isFree        Boolean                @default(false)
  status        CourseEnrollmentStatus @default(PENDING)
  paymentStatus PaymentStatus          @default(PENDING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([courseId, workerId])
  @@index([workerId])
  @@map("course_enrollments")
}

// ─── SERVICES ────────────────────────────────────────────────────────────────

model ServiceCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  iconUrl     String?
  description String?

  // Base price per tier for the SMALL lot size (ARS)
  basePriceStandard Float
  basePricePremium  Float

  // Per-m² surcharge applied above the SMALL threshold, per tier (ARS/m²)
  pricePerM2Standard Float @default(0)
  pricePerM2Premium  Float @default(0)

  // JSON array of addon definitions available for this category.
  // Shape: [{ key: string, label: string, surchargeType: "flat"|"percent", value: number }]
  // Example: [{ key: "tall_grass", label: "Pasto alto (+20%)", surchargeType: "percent", value: 20 }]
  addonDefinitions Json @default("[]")

  isActive Boolean @default(true)

  workerServices  WorkerService[]
  serviceRequests ServiceRequest[]
  subscriptions   Subscription[]

  @@index([slug])
  @@map("service_categories")
}

// Pivot: which categories a worker offers, at which equipment tier
model WorkerService {
  id              String        @id @default(cuid())
  workerId        String
  categoryId      String
  equipmentTier   EquipmentTier @default(STANDARD)
  yearsExperience Int           @default(0)
  // Portfolio: array of photo URLs showcasing past work
  portfolio       Json          @default("[]")
  isActive        Boolean       @default(true)

  worker   WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([workerId, categoryId])
  @@map("worker_services")
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

model ServiceRequest {
  id         String      @id @default(cuid())
  clientId   String
  categoryId String
  workerId   String?
  status     OrderStatus @default(SEARCHING)

  // Location of the job
  address          String
  latitude         Float
  longitude        Float
  isGatedCommunity Boolean @default(false) // copied from ClientAddress at creation time

  // Visual lot sizing + optional exact area
  lotSize   LotSize?
  lotAreaM2 Float?

  // Selected addons (array of addon keys from ServiceCategory.addonDefinitions)
  // Example: ["tall_grass", "remove_weeds"]
  addons Json @default("[]")

  // Pricing
  quotedPrice Float?  // price shown to client before confirmation
  finalPrice  Float?  // price after any adjustments (disputes, etc.)
  platformFeePercent Float @default(15) // TUKI commission %

  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?       // MercadoPago preference/intent ID

  // Scheduling (for subscription-generated orders)
  scheduledAt DateTime?

  // Evidence: worker must upload this before moving to FINISHED_PENDING_APPROVAL
  completionPhotoUrl String?

  description       String?
  estimatedDuration Int?    // in minutes

  // Timestamps for auto-release logic
  // Set when worker transitions to FINISHED_PENDING_APPROVAL
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       ClientProfile   @relation(fields: [clientId], references: [id])
  worker       WorkerProfile?  @relation(fields: [workerId], references: [id])
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  review       Review?
  transactions Transaction[]
  chatMessages ChatMessage[]

  @@index([clientId, status])
  @@index([workerId, status])
  @@index([status, categoryId])
  @@map("service_requests")
}

// ─── SUBSCRIPTIONS ("TUKI Favorito") ─────────────────────────────────────────

model Subscription {
  id               String                @id @default(cuid())
  clientId         String
  workerId         String?               // preferred worker (the one the client rated and subscribed to)
  categoryId       String
  frequency        SubscriptionFrequency
  dayOfWeek        Int                   // 0=Sunday … 6=Saturday
  timeSlot         String                // "09:00", "14:00", etc.
  isActive         Boolean               @default(true)
  nextServiceDate  DateTime?
  pricePerVisit    Float
  startedAt        DateTime              @default(now())
  cancelledAt      DateTime?
  cancellationNote String?

  // Where the service takes place
  address          String                @default("")
  latitude         Float                 @default(0)
  longitude        Float                 @default(0)

  // Scheduling preferences
  preferSameWorker Boolean               @default(false)
  description      String?

  client   ClientProfile   @relation(fields: [clientId], references: [id])
  worker   WorkerProfile?  @relation(fields: [workerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([clientId, isActive])
  @@index([workerId, isActive])
  @@map("subscriptions")
}

// ─── REVIEWS ─────────────────────────────────────────────────────────────────

model Review {
  id               String      @id @default(cuid())
  serviceRequestId String      @unique
  reviewerId       String
  revieweeId       String
  rating           Int         // 1–5 stars
  comment          String?
  // Qualitative tags chosen by the client, e.g. ["PUNCTUAL","TIDY"]
  tags             ReviewTag[]
  createdAt        DateTime    @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  reviewer       User           @relation("ReviewerRelation", fields: [reviewerId], references: [id])
  reviewee       User           @relation("RevieweeRelation", fields: [revieweeId], references: [id])

  @@index([revieweeId])
  @@map("reviews")
}

// ─── PAYMENTS & ESCROW ───────────────────────────────────────────────────────

model Transaction {
  id               String            @id @default(cuid())
  serviceRequestId String
  amount           Float             // total charged to client (ARS)
  currency         String            @default("ARS")
  method           TransactionMethod
  status           TransactionStatus @default(PENDING)

  // MercadoPago identifiers
  mpPaymentId    String?
  mpPreferenceId String?

  // Escrow lifecycle
  escrowStatus EscrowStatus @default(HELD)
  heldAt       DateTime?    // when funds were captured
  releasedAt   DateTime?    // when funds were released to worker
  frozenAt     DateTime?    // when dispute was raised
  refundedAt   DateTime?    // when refund was issued

  // Worker earnings after TUKI commission
  workerEarnings Float?
  platformFee    Float?

  // Raw webhook payload for audit / debugging
  rawWebhookData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@index([serviceRequestId])
  @@index([mpPaymentId])
  @@index([escrowStatus])
  @@map("transactions")
}

// ─── SUPPORT / DISPUTES ──────────────────────────────────────────────────────

model Dispute {
  id               String   @id @default(cuid())
  serviceRequestId String   @unique
  raisedByUserId   String
  reason           String
  evidenceUrls     Json     @default("[]") // photos/messages provided by either party
  // Resolution
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolution       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([serviceRequestId])
  @@map("disputes")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   // "ORDER_UPDATE" | "PAYMENT" | "REVIEW" | "CHAT" | "SYSTEM"
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── CHAT ────────────────────────────────────────────────────────────────────

model ChatMessage {
  id               String   @id @default(cuid())
  serviceRequestId String
  senderId         String
  senderName       String
  message          String
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  sender         User           @relation(fields: [senderId], references: [id])

  @@index([serviceRequestId, createdAt])
  @@map("chat_messages")
}
