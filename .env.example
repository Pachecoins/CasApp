# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://casapp:casapp@localhost:5432/casapp_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── MercadoPago ─────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ─── Google Maps (opcional, se usa Leaflet por defecto) ──────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Cloudinary (fotos de perfil y portfolio) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── App URLs ─────────────────────────────────────────────────────────────────
CLIENT_APP_URL=http://localhost:5173
WORKER_APP_URL=http://localhost:5174
API_URL=http://localhost:3000

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Generá tus claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@casapp.ar

# ─── Config de plataforma ────────────────────────────────────────────────────
PLATFORM_COMMISSION=0.20
PORT=3000
NODE_ENV=development
