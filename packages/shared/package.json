{
  "name": "@tuki/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for Tuki",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils/price.js": {
      "import": "./dist/utils/price.js",
      "require": "./dist/utils/price.js",
      "types": "./dist/utils/price.d.ts"
    },
    "./utils/distance.js": {
      "import": "./dist/utils/distance.js",
      "require": "./dist/utils/distance.js",
      "types": "./dist/utils/distance.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
